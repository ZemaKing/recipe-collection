VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only for `npm run verify:rls` (Phase 33). Never VITE_-prefixed.
# RLS_ADMIN_*: the owner's login. RLS_USER_*: a user added by hand in the
# dashboard (Authentication -> Add user) that is NOT in admin_users.
RLS_ADMIN_EMAIL=
RLS_ADMIN_PASSWORD=
RLS_USER_EMAIL=
RLS_USER_PASSWORD=

# Optional, for images:audit / images:backup / db:export (Phase 34). Never
# VITE_-prefixed, never committed. Without it those scripts sign in with
# RLS_ADMIN_* instead (enough for everything except exporting admin_users).
SUPABASE_SERVICE_ROLE_KEY=
