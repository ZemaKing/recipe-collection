{
  "name": "recipe-collection",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "verify:rls": "node scripts/verify-rls.mjs",
    "images:audit": "node scripts/images-audit.ts",
    "images:backup": "node scripts/images-backup.ts",
    "db:export": "node scripts/db-export.ts",
    "images:migrate": "node scripts/images/cli.ts scripts/migrate-images/recipe-job.ts scripts/migrate-images/ingredient-job.ts upload",
    "images:check": "node scripts/images/cli.ts scripts/migrate-images/recipe-job.ts scripts/migrate-images/ingredient-job.ts verify",
    "images:flip": "node scripts/migrate-images/flip.ts",
    "images:prune-originals": "node scripts/migrate-images/prune.ts",
    "perf:vitals": "node scripts/perf/vitals.mjs",
    "postbuild": "node scripts/check-bundle-secrets.mjs && node scripts/check-csp.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
